rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function profileExists() { return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.token.email)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data; }
    function isOwnerAdmin() { return isAuthenticated() && request.auth.token.email == "r.camargo.pires@gmail.com" && request.auth.token.email_verified == true; }

    // O avaliador é deliberadamente retirado do acesso operacional genérico.
    // Ele recebe somente as permissões MarketIQ declaradas abaixo.
    function isActive() {
      return isOwnerAdmin() || (
        profileExists() &&
        profile().status == 'active' &&
        profile().role != 'evaluator'
      );
    }
    function isEvaluator() {
      return isAuthenticated() && profileExists() && profile().status == 'active' && profile().role == 'evaluator';
    }
    function role() { return isOwnerAdmin() ? 'admin' : (profileExists() ? profile().role : ''); }
    function isAdmin() { return isActive() && role() == 'admin'; }
    function isManager() { return isActive() && (role() == 'manager' || role() == 'admin'); }
    function isSeller() { return isActive() && (role() == 'seller' || role() == 'user'); }
    function hasDmsOverride(key) {
      return profileExists() &&
        ('dmsPermissionOverrides' in profile()) &&
        (key in profile().dmsPermissionOverrides);
    }
    function dmsPermission(key, managementDefault, preparationDefault, financeDefault) {
      return isAdmin() || (
        role() == 'manager' && (
          (hasDmsOverride(key) && profile().dmsPermissionOverrides[key] == true) ||
          (
            !hasDmsOverride(key) && (
              !('dmsAccessProfile' in profile()) ||
              (profile().dmsAccessProfile == 'management' && managementDefault) ||
              (profile().dmsAccessProfile == 'preparation' && preparationDefault) ||
              (profile().dmsAccessProfile == 'finance' && financeDefault)
            )
          )
        )
      );
    }
    function canUsersManage() { return dmsPermission('usersManage', true, false, false); }
    function canCrm() { return dmsPermission('crmView', true, false, false); }
    function canEvaluations() { return dmsPermission('evaluationsView', true, false, false); }
    function canPurchases() { return dmsPermission('purchasesView', true, false, false); }
    function canSales() { return dmsPermission('salesView', true, false, false); }
    function canStockView() { return dmsPermission('stockView', true, true, false); }
    function canStockWrite() { return dmsPermission('stockWrite', true, false, false); }
    function canPrepView() { return dmsPermission('prepView', true, true, false); }
    function canPrepRequest() { return dmsPermission('prepRequest', true, true, false); }
    function canPrepApprove() { return dmsPermission('prepApprove', true, false, false); }
    function canFinanceView() { return dmsPermission('financeView', true, false, true); }
    function canFinanceCreate() { return dmsPermission('financeCreate', false, false, true); }
    function canFinanceSettle() { return dmsPermission('financeSettle', false, false, true); }
    function canDocuments() { return dmsPermission('documentsView', true, false, false); }
    function canAfterSales() { return dmsPermission('afterSalesView', true, false, false); }
    function canReports() { return dmsPermission('reportsView', true, false, false); }
    function canDiagnostics() { return dmsPermission('diagnostics', true, false, false); }
    function opKind(data) { return ('kind' in data) ? data.kind : ''; }
    function financeOriginAllowed(data) {
      return ('origin' in data) && (
        (data.origin == 'prep' && canPrepApprove()) ||
        (data.origin == 'purchase' && canPurchases()) ||
        ((data.origin == 'sale' || data.origin == 'commission') && canSales())
      );
    }
    function attachmentReadAllowed(data) {
      return ('entityType' in data) && (
        (data.entityType == 'prep_service' && canPrepView()) ||
        (data.entityType == 'finance_entry' && canFinanceView()) ||
        (data.entityType == 'vehicle_document' && canDocuments()) ||
        (data.entityType == 'sales_order' && canSales()) ||
        (data.entityType == 'purchase' && canPurchases()) ||
        (data.entityType == 'after_sales' && canAfterSales())
      );
    }
    function attachmentWriteAllowed(data) {
      return ('entityType' in data) && (
        (data.entityType == 'prep_service' && (canPrepRequest() || canPrepApprove())) ||
        (data.entityType == 'finance_entry' && (canFinanceCreate() || canFinanceSettle())) ||
        (data.entityType == 'vehicle_document' && canDocuments()) ||
        (data.entityType == 'sales_order' && canSales()) ||
        (data.entityType == 'purchase' && canPurchases()) ||
        (data.entityType == 'after_sales' && canAfterSales())
      );
    }
    function operationalReadAllowed(data) {
      return
        (opKind(data) == '' && (canReports() || canStockView())) ||
        (opKind(data) == 'finance_entry' && (canFinanceView() || financeOriginAllowed(data))) ||
        (opKind(data) in ['finance_account','finance_chart_account','finance_cost_center','finance_reconciliation','finance_closing','finance_reversal_request'] && canFinanceView()) ||
        (opKind(data) == 'vehicle_purchase' && canPurchases()) ||
        (opKind(data) == 'sales_order' && canSales()) ||
        (opKind(data) == 'vehicle_master' && (canStockView() || canPurchases() || canSales() || canPrepView() || canDocuments() || canAfterSales() || canEvaluations())) ||
        (opKind(data) == 'stock_movement' && canStockView()) ||
        (opKind(data) == 'vehicle_document_case' && canDocuments()) ||
        (opKind(data) == 'after_sales_case' && canAfterSales()) ||
        (opKind(data) == 'customer_master' && (canCrm() || canSales())) ||
        (opKind(data) == 'supplier_master' && (canPrepView() || canPurchases() || canFinanceView() || canAfterSales())) ||
        (opKind(data) == 'vehicle_history' && (canPrepView() || canPurchases() || canSales() || canDocuments() || canAfterSales())) ||
        (opKind(data) == 'dms_attachment' && attachmentReadAllowed(data)) ||
        (opKind(data) in ['dms_error','dms_performance'] && canDiagnostics()) ||
        (opKind(data) == 'audit_event' && (canDiagnostics() || canUsersManage())) ||
        (opKind(data) in ['dms_migration_report','dms_integrity_report','dms_migration_version'] && canDiagnostics());
    }
    function operationalCreateAllowed(data) {
      return
        (opKind(data) == '' && (canStockWrite() || canReports())) ||
        (opKind(data) == 'finance_entry' && (canFinanceCreate() || financeOriginAllowed(data))) ||
        (opKind(data) in ['finance_account','finance_chart_account','finance_cost_center'] && canFinanceCreate()) ||
        (opKind(data) in ['finance_reconciliation','finance_closing','finance_reversal_request'] && canFinanceSettle()) ||
        (opKind(data) == 'vehicle_purchase' && canPurchases()) ||
        (opKind(data) == 'sales_order' && canSales()) ||
        (opKind(data) in ['vehicle_master','stock_movement'] && (canStockWrite() || canPurchases() || canSales() || canPrepApprove())) ||
        (opKind(data) == 'vehicle_document_case' && canDocuments()) ||
        (opKind(data) == 'after_sales_case' && canAfterSales()) ||
        (opKind(data) == 'customer_master' && (canCrm() || canSales())) ||
        (opKind(data) == 'supplier_master' && (canPrepRequest() || canPurchases() || canFinanceCreate() || canAfterSales())) ||
        (opKind(data) == 'vehicle_history' && (canPrepRequest() || canPrepApprove() || canPurchases() || canSales() || canDocuments() || canAfterSales())) ||
        (opKind(data) == 'dms_attachment' && attachmentWriteAllowed(data)) ||
        (opKind(data) in ['dms_error','dms_performance'] && isActive()) ||
        (opKind(data) == 'audit_event' && role() == 'manager') ||
        (opKind(data) in ['dms_migration_report','dms_integrity_report','dms_migration_version'] && canDiagnostics());
    }
    function operationalUpdateAllowed(oldData, newData) {
      return
        (
          opKind(oldData) == 'finance_entry' &&
          opKind(newData) == 'finance_entry' &&
          (
            canFinanceSettle() ||
            (
              financeOriginAllowed(oldData) &&
              newData.status == oldData.status &&
              (
                (!('settledAt' in oldData) && !('settledAt' in newData)) ||
                (('settledAt' in oldData) && ('settledAt' in newData) && newData.settledAt == oldData.settledAt)
              )
            )
          )
        ) ||
        (opKind(oldData) in ['finance_account','finance_chart_account','finance_cost_center'] && canFinanceCreate()) ||
        (opKind(oldData) in ['finance_reconciliation','finance_closing','finance_reversal_request'] && canFinanceSettle()) ||
        (opKind(oldData) == 'vehicle_purchase' && canPurchases()) ||
        (opKind(oldData) == 'sales_order' && canSales()) ||
        (opKind(oldData) == 'vehicle_master' && (canStockWrite() || canPurchases() || canSales() || canPrepApprove() || canDocuments() || canAfterSales())) ||
        (opKind(oldData) == 'stock_movement' && canStockWrite()) ||
        (opKind(oldData) == 'vehicle_document_case' && canDocuments()) ||
        (opKind(oldData) == 'after_sales_case' && canAfterSales()) ||
        (opKind(oldData) == 'customer_master' && (canCrm() || canSales())) ||
        (opKind(oldData) == 'supplier_master' && (canPrepRequest() || canPurchases() || canFinanceCreate() || canAfterSales())) ||
        (opKind(oldData) == 'vehicle_history' && (canPrepRequest() || canPrepApprove() || canPurchases() || canSales() || canDocuments() || canAfterSales())) ||
        (opKind(oldData) in ['dms_migration_report','dms_integrity_report'] && canDiagnostics()) ||
        (opKind(oldData) == '' && (canStockWrite() || canReports()));
    }
    function isReception() { return isActive() && role() == 'reception'; }
    function isDirector() { return isActive() && role() == 'director'; }
    function myCompany() { return profileExists() && ('companyId' in profile()) ? profile().companyId : 'abrao-reze'; }
    function myStore() { return profileExists() && ('storeId' in profile()) ? profile().storeId : 'outlet-sorocaba'; }
    function dataCompany(data) { return ('companyId' in data) ? data.companyId : 'abrao-reze'; }
    function dataStore(data) { return ('storeId' in data) ? data.storeId : 'outlet-sorocaba'; }
    function sameCompany(data) { return isActive() && dataCompany(data) == myCompany(); }
    function sameStore(data) {
      return sameCompany(data) && (
        dataStore(data) == myStore() ||
        (
          profileExists() &&
          ('storeIds' in profile()) &&
          dataStore(data) in profile().storeIds
        )
      );
    }
    function evaluatorSameStore(data) { return isEvaluator() && dataCompany(data) == myCompany() && dataStore(data) == myStore(); }
    function ownsDeal() { return resource.data.userId == request.auth.token.email || resource.data.userId == request.auth.uid; }
    function createsOwnDeal() { return request.resource.data.userId == request.auth.token.email || request.resource.data.userId == request.auth.uid; }
    function assignedPassage(data) { return isSeller() && data.assignedSellerEmail == request.auth.token.email; }
    function assignedAction(data) {
      return isSeller() && ('kind' in data) && data.kind == 'action_task' &&
        ('assignedToEmail' in data) && data.assignedToEmail == request.auth.token.email;
    }
    function isMarketIqRecord(data) {
      return ('kind' in data) && data.kind in ['marketiq_evaluation', 'marketiq_vehicle_identity', 'marketiq_media'];
    }

    match /users/{email} {
      allow read: if isAuthenticated() && (
        request.auth.token.email == email ||
        isAdmin() ||
        (canUsersManage() && sameCompany(resource.data)) ||
        ((role() == 'seller' || role() == 'user') && sameStore(resource.data))
      );

      allow create: if isAdmin() || (
        canUsersManage() &&
        sameCompany(request.resource.data) &&
        request.resource.data.companyId == myCompany() &&
        request.resource.data.email == email &&
        request.resource.data.role in ['manager', 'seller', 'user', 'reception', 'evaluator']
      );

      allow update: if isAdmin() || (
        canUsersManage() &&
        sameCompany(resource.data) &&
        sameCompany(request.resource.data) &&
        resource.data.companyId == request.resource.data.companyId &&
        request.resource.data.companyId == myCompany() &&
        resource.data.email == request.resource.data.email &&
        request.resource.data.email == email &&
        resource.data.role in ['manager', 'seller', 'user', 'reception', 'evaluator'] &&
        request.resource.data.role in ['manager', 'seller', 'user', 'reception', 'evaluator']
      );

      allow delete: if isAdmin() || (
        canUsersManage() &&
        sameCompany(resource.data) &&
        resource.data.role in ['manager', 'seller', 'user', 'reception', 'evaluator'] &&
        request.auth.token.email != email
      );
    }

    match /deals/{dealId} {
      allow read: if isAdmin() ||
        (canSales() && sameStore(resource.data)) ||
        (isSeller() && ownsDeal() && sameStore(resource.data));
      allow create: if isAdmin() ||
        (canSales() && sameStore(request.resource.data)) ||
        (isSeller() && createsOwnDeal() && sameStore(request.resource.data));
      allow update: if isAdmin() ||
        (canSales() && sameStore(resource.data) && sameStore(request.resource.data)) ||
        (isSeller() && ownsDeal() && createsOwnDeal() && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin();
    }

    match /evaluation_requests/{requestId} {
      allow read: if isAdmin() ||
        (canEvaluations() && sameStore(resource.data)) ||
        (isSeller() && sameStore(resource.data) && resource.data.requesterEmail == request.auth.token.email) ||
        evaluatorSameStore(resource.data);

      allow create: if isAdmin() || (
        isSeller() && sameStore(request.resource.data) &&
        request.resource.data.requesterEmail == request.auth.token.email &&
        request.resource.data.status == 'requested'
      );

      allow update: if isAdmin() ||
        (canEvaluations() && sameStore(resource.data) && sameStore(request.resource.data)) ||
        (
          evaluatorSameStore(resource.data) && evaluatorSameStore(request.resource.data) &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.requesterEmail == resource.data.requesterEmail &&
          request.resource.data.evaluatorEmail == request.auth.token.email &&
          request.resource.data.status in ['in_progress', 'completed', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'evaluatorEmail', 'evaluatorName', 'startedAt', 'recommendedBuy',
            'marketIqEvaluationId', 'completedAt', 'updatedAt'
          ])
        );
      allow delete: if isAdmin();
    }

    match /config/{document} {
      allow read: if isAdmin() ||
        (isDirector() && document == 'performance') ||
        (isEvaluator() && document == ('group_stock_' + myCompany())) ||
        (
          isActive() && !isReception() && !isDirector() &&
          document != 'companies' && document != 'multistore' && document != 'tenant_security'
        );
      allow write: if isAdmin();
    }

    match /director_scope/{companyId} {
      allow read: if isAdmin() ||
        (isDirector() && companyId == myCompany() && resource.data.companyId == myCompany()) ||
        (role() == 'manager' && companyId == myCompany() && resource.data.companyId == myCompany());
      allow write: if isAdmin();
    }

    match /operational_stock/{itemId} {
      allow read: if isAdmin() || (isDirector() && sameCompany(resource.data)) || (canStockView() && sameStore(resource.data));
      allow create: if isAdmin() || (canStockWrite() && sameStore(request.resource.data)) || (canPurchases() && sameStore(request.resource.data));
      allow update: if isAdmin() ||
        ((canStockWrite() || canPurchases() || canSales() || canPrepApprove()) && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin() || (canStockWrite() && sameStore(resource.data));
    }

    match /operational_sales/{itemId} {
      allow read: if isAdmin() || ((canSales() || canReports()) && sameStore(resource.data));
      allow create: if isAdmin() || (canSales() && sameStore(request.resource.data));
      allow update: if isAdmin() || (canSales() && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin();
    }

    match /market_presence/{itemId} {
      allow read: if isAdmin() || (canStockView() && sameStore(resource.data));
      allow create: if isAdmin() || (canStockWrite() && sameStore(request.resource.data));
      allow update: if isAdmin() || (canStockWrite() && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin() || (canStockWrite() && sameStore(resource.data));
    }

    match /prep_orders/{itemId} {
      allow read: if isAdmin() || (canPrepView() && sameStore(resource.data));
      allow create: if isAdmin() || (canPrepRequest() && sameStore(request.resource.data));
      allow update: if isAdmin() || ((canPrepRequest() || canPrepApprove()) && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin() || (canPrepApprove() && sameStore(resource.data));
    }

    match /prep_payables/{itemId} {
      allow read: if isAdmin() || ((canPrepView() || canFinanceView()) && sameStore(resource.data));
      allow create: if isAdmin() || (canPrepApprove() && sameStore(request.resource.data));
      allow update: if isAdmin() || (canFinanceSettle() && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin();
    }

    match /vehicle_history/{itemId} {
      allow read: if isAdmin() || ((canPrepView() || canPurchases() || canSales() || canDocuments() || canAfterSales()) && sameStore(resource.data));
      allow create: if isAdmin() || ((canPrepRequest() || canPrepApprove() || canPurchases() || canSales() || canDocuments() || canAfterSales()) && sameStore(request.resource.data));
      allow update: if isAdmin() || ((canPrepApprove() || canDocuments() || canAfterSales()) && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin();
    }

    match /showroom_passages/{passageId} {
      allow read: if isAdmin() ||
        (canCrm() && sameStore(resource.data)) ||
        (isReception() && sameStore(resource.data)) ||
        (assignedPassage(resource.data) && sameStore(resource.data));
      allow create: if isAdmin() ||
        (canCrm() && sameStore(request.resource.data)) ||
        (isReception() && sameStore(request.resource.data));
      allow update: if isAdmin() ||
        (canCrm() && sameStore(resource.data) && sameStore(request.resource.data)) ||
        (
          assignedPassage(resource.data) && sameStore(resource.data) && sameStore(request.resource.data) &&
          request.resource.data.assignedSellerEmail == resource.data.assignedSellerEmail &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.storeId == resource.data.storeId &&
          request.resource.data.customerName == resource.data.customerName &&
          request.resource.data.phone == resource.data.phone &&
          request.resource.data.interestModel == resource.data.interestModel &&
          request.resource.data.createdAt == resource.data.createdAt
        );
      allow delete: if isAdmin();
    }

    match /showroom_queue/{queueId} {
      allow read: if isAdmin() || (canCrm() && sameStore(resource.data)) || (isReception() && sameStore(resource.data));
      allow create: if isAdmin() || (canCrm() && sameStore(request.resource.data));
      allow update: if isAdmin() ||
        (canCrm() && sameStore(resource.data) && sameStore(request.resource.data)) ||
        (
          isReception() && sameStore(resource.data) && sameStore(request.resource.data) &&
          request.resource.data.sellers == resource.data.sellers &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.storeId == resource.data.storeId
        );
      allow delete: if isAdmin();
    }

    match /operational_meta/{itemId} {
      allow read: if isAdmin() ||
        (isDirector() && sameCompany(resource.data)) ||
        (sameStore(resource.data) && operationalReadAllowed(resource.data)) ||
        (assignedAction(resource.data) && sameStore(resource.data)) ||
        (evaluatorSameStore(resource.data) && isMarketIqRecord(resource.data));

      allow create: if isAdmin() ||
        (sameStore(request.resource.data) && operationalCreateAllowed(request.resource.data)) ||
        (evaluatorSameStore(request.resource.data) && isMarketIqRecord(request.resource.data));

      allow update: if opKind(resource.data) != 'audit_event' && (
        isAdmin() ||
        (
          sameStore(resource.data) && sameStore(request.resource.data) &&
          operationalUpdateAllowed(resource.data, request.resource.data)
        ) ||
        (
          assignedAction(resource.data) && assignedAction(request.resource.data) &&
          sameStore(resource.data) && sameStore(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'result', 'updatedAt', 'completedAt']) &&
          request.resource.data.status in ['open', 'in_progress', 'done']
        ) ||
        (
          evaluatorSameStore(resource.data) && evaluatorSameStore(request.resource.data) &&
          isMarketIqRecord(resource.data) && isMarketIqRecord(request.resource.data) &&
          request.resource.data.kind == resource.data.kind &&
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.storeId == resource.data.storeId
        )
      );

      allow delete: if opKind(resource.data) != 'audit_event' && (
        isAdmin() ||
        (
          sameStore(resource.data) &&
          (
            (opKind(resource.data) == 'finance_entry' && canFinanceSettle()) ||
            (opKind(resource.data) == 'vehicle_purchase' && canPurchases()) ||
            (opKind(resource.data) == 'sales_order' && canSales()) ||
            (opKind(resource.data) == 'vehicle_document_case' && canDocuments()) ||
            (opKind(resource.data) == 'after_sales_case' && canAfterSales()) ||
            (opKind(resource.data) == 'dms_attachment' && attachmentWriteAllowed(resource.data)) ||
            (opKind(resource.data) == 'supplier_master' && (canPurchases() || canFinanceCreate())) ||
            (opKind(resource.data) == 'customer_master' && canCrm())
          )
        ) ||
        (
          evaluatorSameStore(resource.data) && resource.data.kind == 'marketiq_media' &&
          ('createdByEmail' in resource.data) && resource.data.createdByEmail == request.auth.token.email
        )
      );
    }

    match /operational_imports/{itemId} {
      allow read: if isAdmin() || (canStockView() && sameStore(resource.data));
      allow create: if isAdmin() || (canStockWrite() && sameStore(request.resource.data));
      allow update, delete: if isAdmin();
    }

    match /seller_performance/{email} {
      allow read: if isAdmin() ||
        (canReports() && sameStore(resource.data)) ||
        (isSeller() && request.auth.token.email == email && sameStore(resource.data));
      allow create: if isAdmin() || (canReports() && sameStore(request.resource.data));
      allow update: if isAdmin() || (role() == 'manager' && sameStore(resource.data) && sameStore(request.resource.data));
      allow delete: if isAdmin();

      match /history/{snapshotDate} {
        allow read: if isAdmin() ||
          (canReports() && sameStore(resource.data)) ||
          (isSeller() && request.auth.token.email == email && sameStore(resource.data));
        allow create: if isAdmin() || (canReports() && sameStore(request.resource.data));
        allow update: if isAdmin() || (role() == 'manager' && sameStore(resource.data) && sameStore(request.resource.data));
        allow delete: if isAdmin();
      }
    }

    match /executive_store_summary/{summaryId} {
      allow read: if isAdmin() || (isDirector() && sameCompany(resource.data));
      allow create: if isAdmin() && sameCompany(request.resource.data);
      allow update: if isAdmin() && sameCompany(resource.data) && sameCompany(request.resource.data) &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.storeId == resource.data.storeId;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
